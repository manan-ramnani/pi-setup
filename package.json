{
  "name": "personal-pi-setup",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Portable snapshot of personal Pi extensions and configuration.",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/chatgpt-fast/index.ts",
      "./extensions/latency-throughput/index.ts",
      "./extensions/parallel/index.ts",
      "./extensions/computer-use/index.ts"
    ],
    "skills": [
      "./skills/parallel-web",
      "./skills/agent-browser",
      "./skills/agent-desktop"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify-launchers": "node --input-type=module -e \"import {capture} from './scripts/lib.mjs'; console.log(capture('npm',['--version'])); console.log(capture('pi',['--version']));\"",
    "audit": "node scripts/audit.mjs",
    "bootstrap": "node scripts/bootstrap.mjs"
  }
}
